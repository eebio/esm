## Transform interaction
## Test specifically the transform menu and its sub-menus

# Main menu -> Transforms.
EXPECT_WAIT:Main Menu (press [q] to quit):
ENTER
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):

# Test several expressions.
ENTER
EXPECT:Test Transform>
TEXT:1 + 1
ENTER
EXPECT:1 + 1 = 2
EXPECT:Test Transform>
TEXT:plate_01_a1
ENTER
EXPECT:0.165
EXPECT:Test Transform>
TEXT:(
ENTER
EXPECT:ParseError
EXPECT:Test Transform>
Q
ENTER
EXPECT:You may have tried to quit the interactive session.
EXPECT:UndefVarError
EXPECT:Test Transform>
ENTER

# Transform name already exists
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):
DOWN
ENTER
EXPECT_WAIT:Enter the name of the new transform (or just press Enter to go back):
EXPECT:New Transform Name>
TEXT:od_sub
ENTER
EXPECT:A transform with the name od_sub already exists

# Empty equation in transform add
EXPECT:New Transform Name>
TEXT:test
ENTER
EXPECT:New Transform Equation>
ENTER
# Same for edit
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):
DOWN
DOWN
DOWN
ENTER
EXPECT_WAIT:Select a transform to edit (press [q] to quit):
ENTER
EXPECT:New Transform Equation>
ENTER

# Add a transform and give it an initial equation.
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):
DOWN
ENTER
EXPECT:New Transform Name>
TEXT:temporary_transform
ENTER
EXPECT:New Transform Equation>
TEXT:1 + 1
ENTER
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):

# Edit the new transform.
DOWN
DOWN
DOWN
ENTER
EXPECT_WAIT:Select a transform to edit
DOWN
DOWN
ENTER
EXPECT:1 + 1
EXPECT:New Transform Equation>
TEXT:2 + 2
ENTER
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):

# Reopen it to verify that editing changed its equation, then leave unchanged.
DOWN
DOWN
DOWN
ENTER
EXPECT_WAIT:Select a transform to edit
DOWN
DOWN
ENTER
EXPECT:2 + 2
EXPECT:New Transform Equation>
ENTER
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):

# Delete the new transform.
DOWN
DOWN
ENTER
EXPECT_WAIT:Select a transform to remove
DOWN
DOWN
ENTER
EXPECT_WAIT:Main Menu / Transforms (press [q] to quit):

